{
  "name": "@repo/react-appwrite",
  "version": "1.0.0",
  "description": "Production-ready, highly developer-friendly, and fully type-safe React library for Appwrite Web SDK with Cache Fusion Engine, unified queries, and realtime sync",
  "license": "ISC",
  "author": "Mohamed Hassan",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "appwrite-react-gen": "./bin/appwrite-react-gen.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/Provider/index.ts",
      "import": "./src/Provider/index.ts",
      "default": "./src/Provider/index.ts"
    },
    "./auth": {
      "types": "./src/Auth/index.ts",
      "import": "./src/Auth/index.ts",
      "default": "./src/Auth/index.ts"
    },
    "./databases": {
      "types": "./src/Databases/index.ts",
      "import": "./src/Databases/index.ts",
      "default": "./src/Databases/index.ts"
    },
    "./storage": {
      "types": "./src/Storage/index.ts",
      "import": "./src/Storage/index.ts",
      "default": "./src/Storage/index.ts"
    },
    "./teams": {
      "types": "./src/Teams/index.ts",
      "import": "./src/Teams/index.ts",
      "default": "./src/Teams/index.ts"
    },
    "./functions": {
      "types": "./src/Functions/index.ts",
      "import": "./src/Functions/index.ts",
      "default": "./src/Functions/index.ts"
    },
    "./messaging": {
      "types": "./src/Messaging/index.ts",
      "import": "./src/Messaging/index.ts",
      "default": "./src/Messaging/index.ts"
    },
    "./utilities": {
      "types": "./src/Utilities/index.ts",
      "import": "./src/Utilities/index.ts",
      "default": "./src/Utilities/index.ts"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "appwrite": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.3"
  }
}
